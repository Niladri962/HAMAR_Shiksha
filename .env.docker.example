# Copy to .env.docker and fill in. Never commit the real file.
POSTGRES_PASSWORD=change-me-long-random
HS_SECRET_KEY=change-me-48-plus-random-characters-use-secrets-token-urlsafe
SITE_ADDRESS=localhost

# production | development. Demo data is refused in production.
HS_ENVIRONMENT=production
HS_ALLOW_DEMO_DATA=false
HS_SEED_DEMO=0
HS_ADMIN_MFA_REQUIRED=true
# Production needs a real SMS/e-mail gateway (see docs/TECHNICAL.md); "log" is refused there.
HS_NOTIFIER=sms-gateway

# Gyan SLM (see docs/MODEL_SELECTION.md)
HS_SLM_MODEL=llama3.2:3b
# Hybrid retrieval: set WITH_EMBEDDINGS=1 and HS_EMBEDDING_MODEL=BAAI/bge-m3 (downloads ~2.3 GB once)
WITH_EMBEDDINGS=0
HS_EMBEDDING_MODEL=
# Voice input (local Whisper): set WITH_VOICE=1 and HS_STT_MODEL=small (downloads ~460 MB once).
# Each uvicorn worker loads its own copy of the model (~1 GB RAM each for "small").
WITH_VOICE=0
HS_STT_MODEL=

# --- Demonstration stack instead (do NOT use for real data) ---
# HS_ENVIRONMENT=development
# HS_ALLOW_DEMO_DATA=true
# HS_SEED_DEMO=1
# HS_NOTIFIER=log
