{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "{app/**,web/**,migrations/**,alembic.ini,deploy/demo.db.gz,data/demo_curriculum/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index?__path=/$1"
    }
  ]
}
